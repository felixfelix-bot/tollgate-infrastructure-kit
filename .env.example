# ──────────────────────────────────────────────────────────────────────
# Tollgate Infrastructure Kit — Environment Configuration
# ──────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# All secrets must be kept in .env (gitignored) — never commit real keys.
# ──────────────────────────────────────────────────────────────────────

# ── VPS Connection ──
VPS_IP=your.vps.ip.address
VPS_USER=debian
VPS_PASSWORD=change_me_to_your_vps_password

# ── Domain Configuration ──
CADDY_DOMAIN=example.com
BASE_DOMAIN=example.com

# ── Friend 1 (Tenant: "ours") ──
FRIEND1_NPUB=npub1your_friend1_npub_here
FRIEND1_NSEC=nsec1your_friend1_nsec_here

# ── Friend 2 (Tenant: "friend1") ──
FRIEND2_NPUB=npub1your_friend2_npub_here
FRIEND2_NSEC=nsec1your_friend2_nsec_here

# ── Friend 3 (Tenant: "friend2") ──
FRIEND3_NPUB=npub1your_friend3_npub_here
FRIEND3_NSEC=nsec1your_friend3_nsec_here

# ── ZAI API Keys ──
ZAI_API_KEY_OURS=your_zai_api_key_for_our_tenant
ZAI_API_KEY_FRIEND=your_zai_api_key_for_friend_tenants

# ── Deployment Admin (Nostr key for infrastructure admin) ──
DEPLOYMENT_ADMIN_NSEC=nsec1your_deployment_admin_nsec_here

# ── Routstr Configuration ──
ROUTSTR_SECRET_KEY=change_me_routstr_secret
ROUTSTR_ADMIN_PASSWORD=change_me_routstr_admin_password
ROUTSTR_UPSTREAM_BASE_URL=https://api.z.ai/api/coding/paas/v4
ROUTSTR_UPSTREAM_API_KEY=your_zai_upstream_api_key
ROUTSTR_NODE_NAME="Multi-Tenant AI Node"
ROUTSTR_NODE_DESCRIPTION="AI inference via Cashu micropayments"
ROUTSTR_LN_ADDRESS=
ROUTSTR_RECEIVE_LN_ADDRESS=you@wallet.com

# ── Cloudflare API ──
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id_here

# ── Shadowsocks (MPTCP server) ──
SHADOWSOCKS_PASSWORD=change_me_shadowsocks_password

# ── Cashu Mint ──
MINT_DOMAIN=mints.example.com
ACME_EMAIL=admin@example.com

# ── FIPS Mesh ──
FIPS_RELAY_URLS=wss://relay.damus.io,wss://nos.lol

# ── Obelisk Relay (NIP-29) ──
OBELISK_ADMIN_NPUB=your_nostr_npub_here
NIP29_RELAY_NSEC=nsec1your_nip29_relay_nsec_here

# ── nsyte CLI (optional — for deploying nsites from the VPS) ──
NSYTE_PRIVATE_KEY=

# ── Auditable Voting (nsite keypair — generated on first deploy) ──
VOTING_NSEC=
VOTING_NPUB=

# ── ACT Runner (CI/CD for GRASP repos — generated on first deploy) ──
ACT_RUNNER_NSEC=
ACT_RUNNER_NPUB=

# ── Relatr (WoT — generated on first deploy) ──
RELATR_SERVER_SECRET_KEY=

# ── Strfry Aggregation Relay ──
STRFRY_AGG_ROOT_NPUB=npub1your_strfry_agg_root_npub_here
STRFRY_AGG_SERVED_NPUBS=

# ── Restic Backup ──
BACKUP_RESTIC_PASSWORD=change_me_restic_password