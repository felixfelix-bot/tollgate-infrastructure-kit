[Unit]
Description=SSD VPS Dual-Vantage Probe
Documentation=https://github.com/felixfelix-bot/tollgate-infrastructure-kit

[Service]
Type=oneshot
ExecStart=/opt/tollgate/scripts/ssd-vps-probe.sh probe
User=root
Group=root
Environment="PROBE_STATE_DIR=/var/lib/ssd-vps-probe"
Environment="PROBE_LOG=/var/log/ssd-vps-probe.log"
Environment="VANTAGE_ID=%H"
Environment="V2_11_TASK_ID=t_v2_11_ssd_ready"
Environment="KANBAN_DB=/home/c03rad0r/.hermes/kanban/boards/hermes-for-friends/kanban.db"

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ssd-vps-probe /var/log
ReadOnlyPaths=/opt/tollgate/scripts

[Install]
WantedBy=multi-user.target
