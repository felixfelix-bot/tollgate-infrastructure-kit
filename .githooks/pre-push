#!/usr/bin/env bash
# pre-push: block pushes whose *pushed commits* contain secrets.
#
# Git passes the refs being pushed on stdin as "<local-ref> <local-sha>
# <remote-ref> <remote-sha>". Scan exactly those ranges. The previous version
# scanned "@{u}..HEAD", which is wrong whenever the checked-out branch differs
# from the ref being pushed (it flagged unrelated history and blocked clean
# pushes).
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
PATTERNS_FILE="$ROOT/.secret-patterns.txt"
[ -f "$PATTERNS_FILE" ] || exit 0

mapfile -t PATTERNS < <(grep -vE '^[[:space:]]*(#|$)' "$PATTERNS_FILE" || true)
ZERO=0000000000000000000000000000000000000000
FOUND=0

scan_patch() {
    local patch="$1" pat match
    for pat in "${PATTERNS[@]}"; do
        match="$(printf '%s\n' "$patch" | grep -nP -e "$pat" | head -5 || true)"
        if [ -n "$match" ]; then
            echo "SECRET in push (pattern: $pat):"
            echo "$match"
            FOUND=1
        fi
    done
}

while read -r _local_ref local_sha _remote_ref remote_sha; do
    [ -n "${local_sha:-}" ] || continue
    [ "$local_sha" = "$ZERO" ] && continue
    if [ "$remote_sha" = "$ZERO" ]; then
        patch="$(git log -p --not --remotes "$local_sha" 2>/dev/null || true)"
    else
        patch="$(git log -p "$remote_sha..$local_sha" 2>/dev/null || true)"
    fi
    scan_patch "$patch"
done

if [ "$FOUND" -eq 1 ]; then
    echo ""
    echo "PUSH BLOCKED — secrets detected in the commits being pushed."
    echo "Scrub with: git filter-repo --replace-text .secret-patterns.txt"
    exit 1
fi

echo "No secrets detected in pushed commits."
exit 0
