services:
  {{ routstr_container_name }}:
    image: {{ routstr_image }}
    container_name: {{ routstr_container_name }}
    restart: unless-stopped
    network_mode: host
    volumes:
      - {{ routstr_data_dir }}:/app/data
      - {{ routstr_log_dir }}:/app/logs
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:{{ routstr_rest_port }}{{ routstr_health_endpoint }} || exit 1"]
      interval: {{ routstr_healthcheck_interval }}
      timeout: {{ routstr_healthcheck_timeout }}
      retries: {{ routstr_healthcheck_retries }}
      start_period: {{ routstr_healthcheck_start_period }}
    environment:
      PORT: "{{ routstr_rest_port }}"
      DATABASE_URL: "sqlite+aiosqlite:////app/data/routstr.db"
      ADMIN_PASSWORD: "{{ routstr_admin_password }}"
      UPSTREAM_BASE_URL: "{{ routstr_upstream_base_url }}"
      UPSTREAM_API_KEY: "{{ routstr_upstream_api_key }}"
      NAME: "{{ routstr_node_name }}"
      DESCRIPTION: "{{ routstr_node_description }}"
      HTTP_URL: "https://{{ routstr_domain }}"
      CASHU_MINTS: "{{ routstr_mint_url }}"
      RELAYS: "{{ routstr_relays }}"
      NSEC: "{{ routstr_nsec }}"
      # RECEIVE_LN_ADDRESS intentionally NOT set here (2026-08-22): the
      # admin-API/DB is the single source of truth for the payout address.
      # Setting it via env would let a container recreate race the DB value
      # (and an empty env would clobber it). Ansible PATCHes it via the
      # admin API after first boot, guarded to never send an empty value.
      LOG_LEVEL: "info"
      CORS_ORIGINS: "*"
      TOR_PROXY_URL: "socks5://127.0.0.1:9050"

  {{ routstr_tor_container_name }}:
    image: {{ routstr_tor_image }}
    container_name: {{ routstr_tor_container_name }}
    restart: unless-stopped
    network_mode: host
    volumes:
      - {{ routstr_tor_dir }}:/var/lib/tor
    environment:
      HS_ROUTER: "127.0.0.1:{{ routstr_rest_port }}:80"
