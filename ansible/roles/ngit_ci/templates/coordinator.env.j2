---
# Coordinator environment. Consumed by docker-compose.yml.j2 through ${VAR}
# substitution, exactly like the hand deployment. Written 0600 — it is the
# runtime config, not a secret store, but the per-repo secrets file
# (ngit-ci-secrets.env) sits next to it and must never be world-readable.
NGIT_CI_REPOS={{ ngit_ci_repos | join(',') }}
NGIT_CI_INDEX_RELAYS={{ ngit_ci_index_relays }}
NGIT_CI_NOSTR_SECRET_RELAYS={{ ngit_ci_nostr_secret_relays }}
NGIT_CI_EXECUTION_POLICY={{ ngit_ci_execution_policy }}
NGIT_CI_ADDITIONAL_REQUESTERS={{ ngit_ci_additional_requesters }}
NGIT_CI_MAX_CONCURRENT_JOBS={{ ngit_ci_max_concurrent_jobs }}
NGIT_CI_ACT_CONTAINER_OPTIONS="{{ ngit_ci_act_container_options }}"
NGIT_CI_ACT_CONTAINER_DAEMON_SOCKET={{ ngit_ci_act_container_daemon_socket }}
NGIT_CI_ACT_BIND_WORKSPACE={{ ngit_ci_act_bind_workspace | bool | lower }}
NGIT_CI_ACT_CACHE_ENABLED={{ ngit_ci_act_cache_enabled | bool | lower }}
NGIT_CI_ACT_CACHE_MAX_BYTES={{ ngit_ci_act_cache_max_bytes }}
NGIT_CI_BLOSSOM_SERVERS={{ ngit_ci_blossom_servers }}
NGIT_CI_BLOSSOM_MAX_LOG_BYTES={{ ngit_ci_blossom_max_log_bytes }}
NGIT_CI_BLOSSOM_MAX_ARTIFACT_BYTES={{ ngit_ci_blossom_max_artifact_bytes }}
NGIT_CI_BLOSSOM_MAX_ARTIFACTS_PER_JOB={{ ngit_ci_blossom_max_artifacts_per_job }}
NGIT_CI_BLOSSOM_UPLOAD_TIMEOUT_SECS={{ ngit_ci_blossom_upload_timeout_secs }}
NGIT_CI_BLOSSOM_UPLOAD_BUDGET_SECS={{ ngit_ci_blossom_upload_budget_secs }}
NGIT_CI_BLOSSOM_ARTIFACT_SERVER_ADDR={{ ngit_ci_blossom_artifact_server_addr }}
NGIT_CI_BLOSSOM_PUBLIC_URL={{ ngit_ci_blossom_public_url }}
NGIT_CI_QUEUE_RECOVERY_WINDOW_SECS={{ ngit_ci_queue_recovery_window_secs }}
NGIT_CI_LOG_LEVEL={{ ngit_ci_log_level }}
NGIT_CI_STOP_GRACE_PERIOD={{ ngit_ci_stop_grace_period }}
