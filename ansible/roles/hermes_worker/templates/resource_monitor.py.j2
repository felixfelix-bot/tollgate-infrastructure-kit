#!/usr/bin/env python3
"""Resource monitor — collects system metrics and feeds them to the Kalman predictor.

Runs as a cron job every 5 minutes. Reads system stats (CPU load, memory, worker count)
and stores them in the zai_usage.db database for the MultiResourceKalmanPredictor.

Deployed by the hermes_worker Ansible role to: ~/.hermes/bot/resource_monitor.py
"""
from __future__ import annotations
import json
import os
import sqlite3
import time

DB_PATH = os.path.expanduser("~/.hermes/bot/zai_usage.db")
CONTEXTVM_PORT = {{ hermes_worker_contextvm_port }}


def collect_system_stats() -> dict:
    """Collect current system resource stats."""
    load_1m = 0.0
    with open("/proc/loadavg") as f:
        load_1m = float(f.read().split()[0])

    meminfo = {}
    with open("/proc/meminfo") as f:
        for line in f:
            parts = line.split(":")
            if len(parts) == 2:
                key = parts[0].strip()
                val = int(parts[1].strip().split()[0]) * 1024
                meminfo[key] = val

    mem_total = meminfo.get("MemTotal", 1)
    mem_available = meminfo.get("MemAvailable", meminfo.get("MemFree", 0))
    memory_pct = ((mem_total - mem_available) / mem_total) * 100.0 if mem_total > 0 else 0.0

    worker_count = 0
    boards_dir = os.path.expanduser("~/.hermes/kanban/boards")
    if os.path.isdir(boards_dir):
        for db_name in os.listdir(boards_dir):
            db_path = os.path.join(boards_dir, db_name, "kanban.db")
            if os.path.isfile(db_path):
                try:
                    conn = sqlite3.connect(db_path)
                    for row in conn.execute(
                        "SELECT COUNT(*) FROM tasks WHERE status='running'"
                    ).fetchall():
                        worker_count += row[0]
                    conn.close()
                except Exception:
                    continue

    return {
        "timestamp": time.time(),
        "cpu_load_1m": load_1m,
        "memory_used_percent": round(memory_pct, 1),
        "worker_count": worker_count,
    }


def ensure_table(conn: sqlite3.Connection) -> None:
    conn.execute("""
        CREATE TABLE IF NOT EXISTS resource_metrics (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            ts REAL NOT NULL,
            cpu_load_1m REAL,
            memory_used_percent REAL,
            worker_count INTEGER
        )
    """)
    conn.execute("CREATE INDEX IF NOT EXISTS idx_resource_metrics_ts ON resource_metrics(ts)")
    conn.commit()


def serve_contextvm() -> None:
    """Start a simple HTTP server serving JSON stats on the configured port."""
    from http.server import HTTPServer, BaseHTTPRequestHandler

    class Handler(BaseHTTPRequestHandler):
        def do_GET(self):
            stats = collect_system_stats()
            meminfo = {}
            with open("/proc/meminfo") as f:
                for line in f:
                    parts = line.split(":")
                    if len(parts) == 2:
                        key = parts[0].strip()
                        val = int(parts[1].strip().split()[0]) * 1024
                        meminfo[key] = val

            loadavg = {}
            with open("/proc/loadavg") as f:
                parts = f.read().split()
                loadavg["load_1m"] = float(parts[0])
                loadavg["load_5m"] = float(parts[1])
                loadavg["load_15m"] = float(parts[2])

            response = {
                "memory": {
                    "total": meminfo.get("MemTotal", 0),
                    "available": meminfo.get("MemAvailable", 0),
                    "used": meminfo.get("MemTotal", 0) - meminfo.get("MemAvailable", 0),
                    "percent": stats["memory_used_percent"],
                },
                "load_avg": loadavg,
                "worker_count": stats["worker_count"],
                "timestamp": stats["timestamp"],
                "hostname": os.uname().nodename,
            }
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            self.wfile.write(json.dumps(response).encode())

        def log_message(self, *args):
            pass

    server = HTTPServer(("0.0.0.0", CONTEXTVM_PORT), Handler)
    server.serve_forever()


def main():
    import sys

    if "--serve" in sys.argv:
        serve_contextvm()
        return

    stats = collect_system_stats()

    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    try:
        ensure_table(conn)
        conn.execute(
            "INSERT INTO resource_metrics (ts, cpu_load_1m, memory_used_percent, worker_count) "
            "VALUES (?, ?, ?, ?)",
            (stats["timestamp"], stats["cpu_load_1m"], stats["memory_used_percent"], stats["worker_count"]),
        )
        conn.commit()
    finally:
        conn.close()

    print(f"[resource_monitor] ts={stats['timestamp']:.0f} "
          f"cpu_load={stats['cpu_load_1m']:.2f} "
          f"memory={stats['memory_used_percent']:.1f}% "
          f"workers={stats['worker_count']}")


if __name__ == "__main__":
    main()