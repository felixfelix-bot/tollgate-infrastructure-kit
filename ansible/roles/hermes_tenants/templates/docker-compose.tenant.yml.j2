services:
  hermes-{{ tenant_name }}:
    image: {{ hermes_tenants_image }}
    container_name: hermes-{{ tenant_name }}
    # Use the image's default entrypoint (/init) which runs s6-overlay.
    # This allows s6 to properly supervise the gateway service.
    # Do NOT override with 'sleep infinity' - that prevents gateway from starting.
    restart: {{ hermes_tenants_container_restart }}
    stop_grace_period: {{ hermes_tenants_stop_grace_period }}
    env_file:
      - .env
    environment:
      # Route LLM calls through routstrd sidecar for Cashu payment handling
      LLM_PROXY_URL: http://routstrd-{{ tenant_name }}:{{ hermes_tenants_routstrd_config.port }}/v1
    volumes:
      # Must match HERMES_HOME in the image (/opt/data in Dockerfile.slim),
      # otherwise the gateway reads/writes the wrong home.
      - hermes-{{ tenant_name }}-data:/opt/data
      - ./config:/config
      - ./nsec:/nsec:ro
    networks:
      - routstr_default
      - hermes-net-{{ tenant_name }}
    ports:
      - "{{ tenant_gateway_port }}:8080"
    depends_on:
      routstrd-{{ tenant_name }}:
        condition: service_healthy
    healthcheck:
      # HTTP-only: the gateway serves /health via the api_server platform.
      # A pgrep-based check matches its own 'sh -c' wrapper and always passes.
      test: ["CMD-SHELL", "curl -sf http://localhost:8080/health || exit 1"]
      interval: {{ hermes_tenants_healthcheck_interval }}
      timeout: {{ hermes_tenants_healthcheck_timeout }}
      retries: {{ hermes_tenants_healthcheck_retries }}
      start_period: {{ hermes_tenants_healthcheck_start_period }}
    mem_limit: {{ hermes_tenants_resource_limits.memory }}
    mem_reservation: {{ hermes_tenants_resource_reservations.memory }}
    cpus: "{{ hermes_tenants_resource_limits.cpus }}"
    logging:
      driver: {{ hermes_tenants_log_driver }}
      options:
        max-size: {{ hermes_tenants_log_max_size }}
        max-file: "{{ hermes_tenants_log_max_file }}"
    security_opt:
      - no-new-privileges:true

  routstrd-{{ tenant_name }}:
    image: {{ hermes_tenants_routstrd_image }}
    container_name: routstrd-{{ tenant_name }}
    restart: {{ hermes_tenants_container_restart }}
    stop_grace_period: {{ hermes_tenants_stop_grace_period }}
    volumes:
      - routstrd-{{ tenant_name }}-data:/data
    networks:
      - routstr_default
      - hermes-net-{{ tenant_name }}
    healthcheck:
      test: ["CMD-SHELL", "curl -sf http://localhost:{{ hermes_tenants_routstrd_config.port }}/health || exit 1"]
      interval: {{ hermes_tenants_healthcheck_interval }}
      timeout: {{ hermes_tenants_healthcheck_timeout }}
      retries: {{ hermes_tenants_healthcheck_retries }}
      start_period: {{ hermes_tenants_healthcheck_start_period }}
    mem_limit: {{ hermes_tenants_routstrd_resource_limits.memory }}
    mem_reservation: {{ hermes_tenants_routstrd_resource_reservations.memory }}
    cpus: "{{ hermes_tenants_routstrd_resource_limits.cpus }}"
    logging:
      driver: {{ hermes_tenants_log_driver }}
      options:
        max-size: {{ hermes_tenants_log_max_size }}
        max-file: "{{ hermes_tenants_log_max_file }}"
    security_opt:
      - no-new-privileges:true

volumes:
  hermes-{{ tenant_name }}-data:
    external: true
    name: hermes-{{ tenant_name }}-data
  routstrd-{{ tenant_name }}-data:
    external: true
    name: routstrd-{{ tenant_name }}-data

networks:
  routstr_default:
    external: true
  hermes-net-{{ tenant_name }}:
    external: true
    name: hermes-net-{{ tenant_name }}
