# buzz-media-deleter — copy to /opt/buzz-media-deleter/.env (chmod 600).
#
# NEVER commit a filled-in copy of this file. install.sh generates it
# automatically from /opt/buzz-relay/.env; this file documents the shape.

# MinIO credentials. install.sh reuses the relay's root creds.
MD_MINIO_ACCESS_KEY=
MD_MINIO_SECRET_KEY=

# Bearer token the nostr.py bridge presents. Required for any real deployment;
# an unset token disables the auth check (loopback/dev only).
MD_AUTH_TOKEN=

# Optional overrides (defaults shown).
MD_MINIO_ENDPOINT=http://minio:9000
MD_MINIO_BUCKET=buzz-media
MD_MINIO_REGION=us-east-1
MD_LISTEN_PORT=8099
MD_RELAY_NETWORK=buzz-relay-net
MD_TENANT_NETWORK=hermes-net-sitarani
